# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# ---- LLM: answers oncall questions (Anthropic Claude) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Embeddings: turns wiki text into vectors (OpenAI) ----
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Vector store (local Chroma DB for now) ----
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=wiki_articles

# ---- Wiki source articles are fetched from ----
# Placeholder source for now. Swap/add real oncall wiki URLs later.
WIKI_ARTICLE_URLS=https://www.wikihow.com/Bad-Side-Profile

# ---- Reserved for future use: Confluence wiki ingestion ----
CONFLUENCE_BASE_URL=
CONFLUENCE_USER_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=

# ---- Reserved for future use: Snowflake (e.g. Cortex vector search / data pull) ----
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
